# Contact form delivery via Resend (https://resend.com). Leave unset to fall back to a mailto: link.
RESEND_API_KEY=
# Address that receives inquiries. Defaults to mayankgoyal662@gmail.com when unset.
CONTACT_TO_EMAIL=
# Verified sender domain address, e.g. "Portfolio <hello@yourdomain.com>". Resend's onboarding sender works for testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Public site URL used for metadata / Open Graph. Optional on Vercel: the production
# *.vercel.app domain is picked up automatically. Set it only when you add a custom domain.
NEXT_PUBLIC_SITE_URL=
